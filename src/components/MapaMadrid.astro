---
/**
 * MapaMadrid — Choropleth map of Madrid districts
 *
 * Renders a Leaflet map with TopoJSON district boundaries colored by score.
 * Clicking a district navigates to /barrio/[slug].
 *
 * Data: distritos.topo.json (bundled static, WGS84)
 * Tiles: CartoDB Positron (clean, free, no API key)
 */
---

<div id="map-container">
  <div id="map" role="application" aria-label="Mapa interactivo de distritos de Madrid coloreados por puntuacion ambiental"></div>
  <div id="map-legend" aria-label="Leyenda del Indice Verde">
    <h3>Indice Verde</h3>
    <div class="legend-items">
      <div class="legend-item"><span class="legend-color" style="background:#2D6A4F"></span> 85-100 Excelente</div>
      <div class="legend-item"><span class="legend-color" style="background:#52B788"></span> 70-84 Bueno</div>
      <div class="legend-item"><span class="legend-color" style="background:#E9C46A"></span> 55-69 Aceptable</div>
      <div class="legend-item"><span class="legend-color" style="background:#F4A261"></span> 40-54 Mejorable</div>
      <div class="legend-item"><span class="legend-color" style="background:#E76F51"></span> 0-39 Critico</div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin="" />

<script>
  import L from 'leaflet';
  import * as topojson from 'topojson-client';
  import distritosTopoRaw from '../data/distritos.topo.json';
  import { computeGreenIndex, getContextPhrase, getTier } from '../lib/green-index';
  import { fetchAirQuality, aggregateByDistrict } from '../lib/air-quality';
  import { fetchTrafficSummary } from '../lib/traffic';

  function slugify(name: string): string {
    return name
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }

  function titleCase(str: string): string {
    const minor = new Set(['de', 'del', 'el', 'la', 'las', 'los', 'y', 'e']);
    return str.toLowerCase().split(' ')
      .map((w, i) => (i === 0 || !minor.has(w)) ? w.charAt(0).toUpperCase() + w.slice(1) : w)
      .join(' ');
  }

  // --- Compute Green Index (initially without air data, then update) ---

  let greenIndex = computeGreenIndex();
  const indexMap = new Map(greenIndex.map((d) => [d.code, d]));

  const geojson = topojson.feature(distritosTopoRaw as any, (distritosTopoRaw as any).objects.DISTRITOS);

  const map = L.map('map', {
    center: [40.42, -3.70],
    zoom: 11,
    zoomControl: true,
    preferCanvas: true,
    attributionControl: true,
  });

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
    subdomains: 'abcd',
    maxZoom: 18,
  }).addTo(map);

  const districtLayer = L.geoJSON(geojson as any, {
    style: (feature) => {
      const code = feature?.properties?.COD_DIS_TX || '00';
      const d = indexMap.get(code);
      return {
        fillColor: d ? d.tierColor : '#ccc',
        weight: 1.5,
        opacity: 1,
        color: 'white',
        fillOpacity: 0.7,
      };
    },
    onEachFeature: (feature, layer) => {
      const code = feature.properties.COD_DIS_TX;
      const name = feature.properties.NOMBRE || '';
      const displayName = titleCase(name);
      const d = indexMap.get(code);

      if (d) {
        const context = getContextPhrase(d);
        const subText = d.subIndices
          .map((si) => `${si.name}: ${si.score}`)
          .join(' · ');

        layer.bindTooltip(
          `<strong>${displayName}</strong><br/>` +
          `Indice Verde: <strong>${context}</strong><br/>` +
          `<span style="font-size:0.8em">${subText}</span>`,
          { sticky: true, className: 'mv-tooltip' }
        );
      }

      layer.on({
        mouseover: (e) => {
          e.target.setStyle({ weight: 3, color: '#264653', fillOpacity: 0.85 });
          e.target.bringToFront();
        },
        mouseout: (e) => {
          districtLayer.resetStyle(e.target);
        },
        click: () => {
          window.location.href = `/barrio/${slugify(name)}`;
        },
      });
    },
  }).addTo(map);

  map.fitBounds(districtLayer.getBounds(), { padding: [20, 20] });

  // --- Async: fetch real-time air quality and update map ---

  Promise.all([fetchAirQuality(), fetchTrafficSummary()]).then(([readings, traffic]) => {
    const airScores = new Map<string, number>();
    if (readings.length > 0) {
      const airByDistrict = aggregateByDistrict(readings);
      for (const [code, data] of airByDistrict) {
        airScores.set(code, data.score);
      }
    }

    const trafficScore = traffic?.score ?? undefined;

    // Recompute with real air + traffic data
    greenIndex = computeGreenIndex(airScores, trafficScore);
    greenIndex.forEach((d) => indexMap.set(d.code, d));

    // Update map styles and tooltips
    districtLayer.eachLayer((layer: any) => {
      const code = layer.feature?.properties?.COD_DIS_TX;
      const d = indexMap.get(code);
      if (d) {
        layer.setStyle({ fillColor: d.tierColor });
        const displayName = titleCase(layer.feature.properties.NOMBRE || '');
        const context = getContextPhrase(d);
        const subText = d.subIndices.map((si) => `${si.name}: ${si.score}`).join(' · ');
        layer.setTooltipContent(
          `<strong>${displayName}</strong><br/>` +
          `Indice Verde: <strong>${context}</strong><br/>` +
          `<span style="font-size:0.8em">${subText}</span>`
        );
      }
    });

    console.log('[MadridVerde] Air quality data loaded, map updated');
  });

  // --- Geocoding: listen for address search events ---

  let searchMarker: L.Marker | null = null;

  window.addEventListener('mv-geocode', ((e: CustomEvent) => {
    const { lat, lon } = e.detail;

    if (searchMarker) map.removeLayer(searchMarker);

    searchMarker = L.marker([lat, lon], {
      icon: L.divIcon({
        className: 'mv-search-marker',
        html: '<div class="mv-marker-pin"></div>',
        iconSize: [24, 24],
        iconAnchor: [12, 24],
      }),
    }).addTo(map);

    map.setView([lat, lon], 14, { animate: true });
  }) as EventListener);
</script>

<style>
  #map-container {
    position: relative;
    width: 100%;
    min-height: 500px;
    height: calc(100vh - 200px);
    max-height: 800px;
    border-radius: 12px;
    overflow: hidden;
    background: #e8e4de;
  }

  #map {
    width: 100%;
    height: 100%;
  }

  #map-legend {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(245, 241, 235, 0.95);
    padding: 12px 16px;
    border-radius: 8px;
    z-index: 1000;
    font-size: 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  #map-legend h3 {
    font-family: var(--font-display);
    font-size: 0.9rem;
    margin-bottom: 8px;
    color: var(--color-tinta);
  }

  .legend-items {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-piedra);
  }

  .legend-color {
    width: 16px;
    height: 12px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  :global(.mv-search-marker) {
    background: none !important;
    border: none !important;
  }

  :global(.mv-marker-pin) {
    width: 20px;
    height: 20px;
    border-radius: 50% 50% 50% 0;
    background: var(--color-arcilla);
    transform: rotate(-45deg);
    border: 2px solid white;
    box-shadow: 0 2px 6px rgba(0,0,0,0.3);
  }

  :global(.mv-tooltip) {
    font-family: var(--font-body);
    font-size: 0.85rem;
    border-radius: 8px;
    padding: 8px 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 768px) {
    #map-container {
      height: 60vh;
      border-radius: 0;
    }

    #map-legend {
      bottom: 10px;
      right: 10px;
      font-size: 0.7rem;
      padding: 8px 12px;
    }
  }
</style>
