---
/**
 * MapaMadrid — Choropleth map of Madrid districts
 *
 * Renders a Leaflet map with TopoJSON district boundaries colored by score.
 * Clicking a district navigates to /barrio/[slug].
 *
 * Data: distritos.topo.json (bundled static, WGS84)
 * Tiles: CartoDB Positron (clean, free, no API key)
 */
---

<div id="map-container">
  <div id="map" role="application" aria-label="Mapa interactivo de distritos de Madrid coloreados por puntuacion ambiental"></div>
  <div id="map-legend" aria-label="Leyenda del Indice Verde">
    <h3>Indice Verde</h3>
    <div class="legend-items">
      <div class="legend-item"><span class="legend-color" style="background:#2D6A4F"></span> 85-100 Excelente</div>
      <div class="legend-item"><span class="legend-color" style="background:#52B788"></span> 70-84 Bueno</div>
      <div class="legend-item"><span class="legend-color" style="background:#E9C46A"></span> 55-69 Aceptable</div>
      <div class="legend-item"><span class="legend-color" style="background:#F4A261"></span> 40-54 Mejorable</div>
      <div class="legend-item"><span class="legend-color" style="background:#E76F51"></span> 0-39 Critico</div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin="" />

<script>
  import L from 'leaflet';
  import * as topojson from 'topojson-client';
  import distritosTopoRaw from '../data/distritos.topo.json';
  import districtsIndex from '../data/districts-index.json';
  import treesData from '../data/trees.json';
  import demographicsData from '../data/demographics.json';
  import recyclingData from '../data/recycling.json';

  // --- Placeholder scores (until MV-10 implements real Index Verde) ---
  // Use green area m2 per capita as a proxy score (0-100)
  function computePlaceholderScores() {
    const scores: Record<string, { score: number; label: string; trees: number; greenM2: number; population: number }> = {};

    for (const tree of treesData) {
      const demo = demographicsData.find((d: any) => d.code === tree.code);
      const recycling = recyclingData.find((d: any) => {
        // Match by name similarity
        const treeName = (tree.name as string).toUpperCase();
        const recName = (d.name as string).toUpperCase();
        return treeName === recName || treeName.includes(recName) || recName.includes(treeName);
      });

      const population = demo?.population || 100000;
      const greenM2PerCapita = tree.greenM2 / population;
      const treesPerCapita = tree.totalTrees / population;
      const containersPerCapita = (recycling?.total || 0) / population;

      // Normalize to 0-100 (rough: 30 m2/capita = 100)
      const greenScore = Math.min(100, (greenM2PerCapita / 30) * 100);
      const treeScore = Math.min(100, (treesPerCapita / 0.05) * 100);
      const recycleScore = Math.min(100, (containersPerCapita / 0.02) * 100);

      // Weighted average (simplified placeholder)
      const score = Math.round(greenScore * 0.4 + treeScore * 0.35 + recycleScore * 0.25);

      scores[tree.code] = {
        score,
        label: score >= 85 ? 'Excelente' : score >= 70 ? 'Bueno' : score >= 55 ? 'Aceptable' : score >= 40 ? 'Mejorable' : 'Critico',
        trees: tree.totalTrees,
        greenM2: tree.greenM2,
        population,
      };
    }
    return scores;
  }

  function getColor(score: number): string {
    if (score >= 85) return '#2D6A4F';
    if (score >= 70) return '#52B788';
    if (score >= 55) return '#E9C46A';
    if (score >= 40) return '#F4A261';
    return '#E76F51';
  }

  function slugify(name: string): string {
    return name
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }

  function titleCase(str: string): string {
    const minor = new Set(['de', 'del', 'el', 'la', 'las', 'los', 'y', 'e']);
    return str.toLowerCase().split(' ')
      .map((w, i) => (i === 0 || !minor.has(w)) ? w.charAt(0).toUpperCase() + w.slice(1) : w)
      .join(' ');
  }

  function formatNumber(n: number): string {
    return n.toLocaleString('es-ES');
  }

  // --- Init map ---

  const scores = computePlaceholderScores();
  const geojson = topojson.feature(distritosTopoRaw as any, (distritosTopoRaw as any).objects.DISTRITOS);

  const map = L.map('map', {
    center: [40.42, -3.70],
    zoom: 11,
    zoomControl: true,
    preferCanvas: true,
    attributionControl: true,
  });

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',
    subdomains: 'abcd',
    maxZoom: 18,
  }).addTo(map);

  let hoveredLayer: L.Layer | null = null;

  const districtLayer = L.geoJSON(geojson as any, {
    style: (feature) => {
      const code = feature?.properties?.COD_DIS_TX || '00';
      const data = scores[code];
      return {
        fillColor: data ? getColor(data.score) : '#ccc',
        weight: 1.5,
        opacity: 1,
        color: 'white',
        fillOpacity: 0.7,
      };
    },
    onEachFeature: (feature, layer) => {
      const code = feature.properties.COD_DIS_TX;
      const name = feature.properties.NOMBRE || feature.properties.DISTRI_MT || '';
      const displayName = titleCase(name);
      const data = scores[code];

      if (data) {
        const greenPerCap = (data.greenM2 / data.population).toFixed(1);
        layer.bindTooltip(
          `<strong>${displayName}</strong><br/>` +
          `Indice Verde: <strong>${data.score}</strong> (${data.label})<br/>` +
          `${formatNumber(data.trees)} arboles · ${greenPerCap} m²/hab`,
          { sticky: true, className: 'mv-tooltip' }
        );
      }

      layer.on({
        mouseover: (e) => {
          const target = e.target;
          target.setStyle({ weight: 3, color: '#264653', fillOpacity: 0.85 });
          target.bringToFront();
          hoveredLayer = target;
        },
        mouseout: (e) => {
          districtLayer.resetStyle(e.target);
          hoveredLayer = null;
        },
        click: () => {
          const slug = slugify(name);
          window.location.href = `/barrio/${slug}`;
        },
      });
    },
  }).addTo(map);

  // Fit map to districts bounds
  map.fitBounds(districtLayer.getBounds(), { padding: [20, 20] });
</script>

<style>
  #map-container {
    position: relative;
    width: 100%;
    min-height: 500px;
    height: calc(100vh - 200px);
    max-height: 800px;
    border-radius: 12px;
    overflow: hidden;
    background: #e8e4de;
  }

  #map {
    width: 100%;
    height: 100%;
  }

  #map-legend {
    position: absolute;
    bottom: 20px;
    right: 20px;
    background: rgba(245, 241, 235, 0.95);
    padding: 12px 16px;
    border-radius: 8px;
    z-index: 1000;
    font-size: 0.8rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  #map-legend h3 {
    font-family: var(--font-display);
    font-size: 0.9rem;
    margin-bottom: 8px;
    color: var(--color-tinta);
  }

  .legend-items {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-piedra);
  }

  .legend-color {
    width: 16px;
    height: 12px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  :global(.mv-tooltip) {
    font-family: var(--font-body);
    font-size: 0.85rem;
    border-radius: 8px;
    padding: 8px 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 768px) {
    #map-container {
      height: 60vh;
      border-radius: 0;
    }

    #map-legend {
      bottom: 10px;
      right: 10px;
      font-size: 0.7rem;
      padding: 8px 12px;
    }
  }
</style>
