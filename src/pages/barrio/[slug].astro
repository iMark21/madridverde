---
import BaseLayout from '../../layouts/BaseLayout.astro';
import districtsIndex from '../../data/districts-index.json';
import { computeGreenIndex, getContextPhrase } from '../../lib/green-index';

export function getStaticPaths() {
  return districtsIndex.map((d) => ({
    params: { slug: d.slug },
    props: { name: d.name, code: d.code },
  }));
}

interface Props {
  name: string;
  code: string;
}

const { slug } = Astro.params;
const { name, code } = Astro.props;

// Compute index at build time (without real-time air data)
const allDistricts = computeGreenIndex();
const district = allDistricts.find((d) => d.code === code);

function titleCase(str: string): string {
  const minorWords = new Set(['de', 'del', 'el', 'la', 'las', 'los', 'y', 'e']);
  return str
    .toLowerCase()
    .split(' ')
    .map((word, i) => (i === 0 || !minorWords.has(word))
      ? word.charAt(0).toUpperCase() + word.slice(1)
      : word
    )
    .join(' ');
}

const displayName = titleCase(name);
const contextPhrase = district ? getContextPhrase(district) : '--';
---

<BaseLayout title={`${displayName} — MadridVerde`} description={`Indice Verde y metricas medioambientales del distrito ${displayName} de Madrid`}>
  <section class="scorecard">
    <div class="scorecard-header">
      <a href="/" class="back-link">&larr; Volver al mapa</a>
      <div class="district-title">
        <span class="district-code">{code}</span>
        <h1>{displayName}</h1>
      </div>
      {district && <p class="district-pop">{district.population.toLocaleString('es-ES')} habitantes</p>}
    </div>

    {district && (
      <div class="scorecard-grid">
        <div class="score-card score-card--main" style={`background: ${district.tierColor}`}>
          <p class="score-label">Indice Verde</p>
          <p class="score-value">{district.score}</p>
          <p class="score-tier">{district.tier}</p>
          <p class="score-context">{contextPhrase}</p>
        </div>
      </div>

      <div class="sub-indices">
        <h2>Sub-indices</h2>
        <div class="sub-indices-grid">
          {district.subIndices.map((si) => (
            <div class="sub-index">
              <div class="sub-index-header">
                <span class="sub-index-name">{si.name}</span>
                <span class="sub-index-weight">{Math.round(si.weight * 100)}%</span>
              </div>
              <span class="sub-index-value" style={`color: ${si.score >= 70 ? '#2D6A4F' : si.score >= 40 ? '#E9C46A' : '#E76F51'}`}>{si.score}</span>
              <span class="sub-index-detail">{si.detail}</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .scorecard {
    padding: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .back-link {
    font-size: 0.85rem;
    color: var(--color-hoja);
    display: inline-block;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--color-bosque);
  }

  .scorecard-header {
    margin-bottom: 2rem;
  }

  .district-title {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .district-code {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-hoja);
    opacity: 0.6;
  }

  .district-title h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    color: var(--color-bosque);
  }

  .district-pop {
    margin-top: 0.25rem;
    font-size: 0.9rem;
    color: var(--color-piedra);
  }

  .scorecard-grid {
    margin-bottom: 2rem;
  }

  .score-card--main {
    color: white;
    border-radius: 12px;
    padding: 2.5rem;
    text-align: center;
  }

  .score-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .score-value {
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    margin: 0.25rem 0;
  }

  .score-tier {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .score-context {
    font-size: 0.9rem;
    opacity: 0.8;
    font-style: italic;
  }

  .sub-indices {
    margin-top: 2rem;
  }

  .sub-indices h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .sub-indices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
  }

  .sub-index {
    background: white;
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sub-index-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .sub-index-name {
    font-weight: 600;
    color: var(--color-tinta);
  }

  .sub-index-weight {
    font-size: 0.75rem;
    color: var(--color-piedra);
    background: rgba(0,0,0,0.05);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .sub-index-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1.1;
  }

  .sub-index-detail {
    font-size: 0.8rem;
    color: var(--color-piedra);
    line-height: 1.3;
  }

  @media (max-width: 768px) {
    .scorecard {
      padding: 1.5rem 1rem;
    }
    .score-value {
      font-size: 4rem;
    }
    .sub-indices-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
