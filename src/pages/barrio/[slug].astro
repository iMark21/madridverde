---
import BaseLayout from '../../layouts/BaseLayout.astro';
import districtsIndex from '../../data/districts-index.json';

export function getStaticPaths() {
  return districtsIndex.map((d) => ({
    params: { slug: d.slug },
    props: { name: d.name, code: d.code },
  }));
}

interface Props {
  name: string;
  code: string;
}

const { slug } = Astro.params;
const { name, code } = Astro.props;

// Title case: "PUENTE DE VALLECAS" → "Puente de Vallecas"
function titleCase(str: string): string {
  const minorWords = new Set(['de', 'del', 'el', 'la', 'las', 'los', 'y', 'e']);
  return str
    .toLowerCase()
    .split(' ')
    .map((word, i) => (i === 0 || !minorWords.has(word))
      ? word.charAt(0).toUpperCase() + word.slice(1)
      : word
    )
    .join(' ');
}

const displayName = titleCase(name);
---

<BaseLayout title={`${displayName} — MadridVerde`} description={`Indice Verde y metricas medioambientales del distrito ${displayName} de Madrid`}>
  <section class="scorecard">
    <div class="scorecard-header">
      <span class="district-code">{code}</span>
      <h1>{displayName}</h1>
    </div>

    <div class="scorecard-grid">
      <div class="score-card score-card--main">
        <p class="score-label">Indice Verde</p>
        <p class="score-value">--</p>
        <p class="score-context">Pendiente MV-10</p>
      </div>
    </div>

    <div class="sub-indices">
      <h2>Sub-indices</h2>
      <div class="sub-indices-grid">
        <div class="sub-index">
          <span class="sub-index-name">Aire</span>
          <span class="sub-index-weight">30%</span>
          <span class="sub-index-value">--</span>
        </div>
        <div class="sub-index">
          <span class="sub-index-name">Verde</span>
          <span class="sub-index-weight">25%</span>
          <span class="sub-index-value">--</span>
        </div>
        <div class="sub-index">
          <span class="sub-index-name">Ruido</span>
          <span class="sub-index-weight">20%</span>
          <span class="sub-index-value">--</span>
        </div>
        <div class="sub-index">
          <span class="sub-index-name">Movilidad</span>
          <span class="sub-index-weight">15%</span>
          <span class="sub-index-value">--</span>
        </div>
        <div class="sub-index">
          <span class="sub-index-name">Reciclaje</span>
          <span class="sub-index-weight">10%</span>
          <span class="sub-index-value">--</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .scorecard {
    padding: 2rem;
    max-width: 960px;
    margin: 0 auto;
  }

  .scorecard-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .district-code {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-hoja);
    opacity: 0.6;
  }

  .scorecard-header h1 {
    font-size: 2.5rem;
    color: var(--color-bosque);
  }

  .scorecard-grid {
    margin-top: 2rem;
  }

  .score-card--main {
    background: var(--color-bosque);
    color: white;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
  }

  .score-label {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.8;
  }

  .score-value {
    font-family: var(--font-display);
    font-size: 5rem;
    line-height: 1;
    margin: 0.25rem 0;
  }

  .score-context {
    font-style: italic;
    opacity: 0.7;
  }

  .sub-indices {
    margin-top: 3rem;
  }

  .sub-indices h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .sub-indices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1rem;
  }

  .sub-index {
    background: white;
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sub-index-name {
    font-weight: 600;
    color: var(--color-tinta);
  }

  .sub-index-weight {
    font-size: 0.8rem;
    color: var(--color-piedra);
  }

  .sub-index-value {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--color-bosque);
  }
</style>
