<script>
  import emtData from '../data/emt.json';
  import { t } from '../i18n/i18n.js';

  // Populate EMT table
  const tbody = document.getElementById('emt-table-body');
  if (tbody) {
    const rows = (emtData as any[])
      .sort((a, b) => b.totalStops - a.totalStops)
      .map((d) => {
        const freq = d.avgHeadwayMin ? `${d.avgHeadwayMin}` : '--';
        return `<tr>
          <td><a href="/barrio/${d.name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}">${d.name}</a></td>
          <td>${d.totalStops}</td>
          <td>${d.totalLines}</td>
          <td>${freq}</td>
        </tr>`;
      })
      .join('');
    tbody.innerHTML = rows;
  }

  // Fetch live service alerts (protobuf — public endpoint, no auth)
  const alertsEl = document.getElementById('emt-alerts');
  if (alertsEl) {
    import('gtfs-realtime-bindings').then(({ transit_realtime }) => {
      fetch('https://openapi.emtmadrid.es/v1/bus/servicealerts/proto')
        .then((r) => r.arrayBuffer())
        .then((buf) => {
          const feed = transit_realtime.FeedMessage.decode(new Uint8Array(buf));
          const now = Math.floor(Date.now() / 1000);

          // Filter active alerts (current or future)
          const active = feed.entity.filter((e) => {
            const a = e.alert;
            if (!a?.activePeriod?.length) return true;
            return a.activePeriod.some((p) => {
              const end = typeof p.end === 'object' ? p.end.toNumber() : Number(p.end || 0);
              return end === 0 || end > now;
            });
          });

          // Deduplicate by header text
          const seenHeaders = new Set();
          const unique = active.filter((e) => {
            const header = e.alert?.headerText?.translation?.[0]?.text ?? '';
            if (!header || seenHeaders.has(header)) return false;
            seenHeaders.add(header);
            return true;
          });

          if (unique.length === 0) {
            alertsEl.innerHTML = `<p class="emt-no-alerts">${t('index.emtNoAlerts')}</p>`;
            return;
          }

          const html = unique.slice(0, 12).map((e, i) => {
            const a = e.alert!;
            const header = a.headerText?.translation?.[0]?.text ?? '';
            const desc = a.descriptionText?.translation?.[0]?.text ?? '';
            return `<details class="emt-alert-item">
              <summary>${header}</summary>
              <p>${desc}</p>
            </details>`;
          }).join('');

          alertsEl.innerHTML = `
            <h3>${t('index.emtAlertsTitle')} <span class="emt-alert-count">${unique.length}</span></h3>
            ${html}
          `;
        })
        .catch(() => {
          alertsEl.innerHTML = `<p class="emt-alerts-error">${t('index.emtAlertsError')}</p>`;
        });
    }).catch(() => {
      alertsEl.innerHTML = '';
    });
  }
</script>

<!-- Traffic strip below map -->
<script>
  import { fetchTrafficData } from '../lib/traffic';
  import { computeGreenIndex } from '../lib/green-index';
  import { t } from '../i18n/i18n.js';

  // Build district code → slug map
  const districtSlugs: Record<string, string> = {};
  computeGreenIndex().forEach((d) => {
    districtSlugs[d.code] = d.name.toLowerCase().normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  });

  function cleanStreet(raw: string): string {
    let s = raw.trim();
    // 1. Strip prefixes
    s = s.replace(/^\((?:MICRO|AFOROS|TACTICO|TACTICA|TÁCTICO)\)\s*/i, '');
    // 2. Sensor-only IDs
    if (/^PM\d+$/.test(s)) return '';
    // 3. Strip technical codes
    s = s.replace(/\s*Ø\d+/g, '');
    // 4. Strip number before direction: "O'Donnell, 21 E-O" → "O'Donnell E-O"
    s = s.replace(/[,\s]+\d+\s+(?=[NSEO]-[NSEO])/g, ' ');
    // 5. Strip giro/delante/entrada parentheticals
    s = s.replace(/\s*\((?:Delante|GIRO|Entrada|giro)[^)]*\)/gi, '');

    // 6. Parse: STREET DIR(FROM-TO) or STREET DIR - FROM-TO or STREET DIR
    let street = '', tramo = '';
    let m = s.match(/^(.+?)\s+[NSEO]-[NSEO]\s*\((.+)\)\s*$/);
    if (!m) m = s.match(/^(.+?)\s+[NSEO]-[NSEO]\s+-\s*(.+)$/);
    if (m) {
      street = m[1].trim().replace(/,\s*$/, '');
      tramo = m[2].trim().replace(/\)\s*$/, '');
    } else {
      const m2 = s.match(/^(.+?)\s+[NSEO]-[NSEO]\s*$/);
      street = m2 ? m2[1].trim().replace(/,\s*$/, '') : s.split(/\s+-\s+/)[0].trim();
    }

    // 7. Title case (only for ALL CAPS)
    function tc(text: string): string {
      const minor = new Set(['de','del','el','la','las','los','y','e','a']);
      // Fix missing spaces after dots/commas
      text = text.replace(/\.(?=[A-Za-z])/g, '. ').replace(/,(?=[A-Za-z])/g, ', ');
      return text.toLowerCase().split(/\s+/).map((w, i) => {
        if (i > 0 && minor.has(w)) return w;
        // Handle O'donnell → O'Donnell
        w = w.replace(/([´'])\w/, (m) => m[0] + m[1].toUpperCase());
        return w.charAt(0).toUpperCase() + w.slice(1);
      }).join(' ');
    }

    street = street === street.toUpperCase() ? tc(street) : street;
    // 8. Replace ´ with '
    street = street.replace(/´/g, "'");

    // 9. Format: "Street (From → To)" or just "Street"
    if (tramo) {
      const parts = tramo.split('-').map(p => p.trim()).filter(Boolean);
      const formattedParts = parts.map(p => p === p.toUpperCase() ? tc(p) : p).map(p => p.replace(/´/g, "'"));
      if (formattedParts.length >= 2) {
        street += ` (${formattedParts[0]} → ${formattedParts[formattedParts.length - 1]})`;
      }
    }
    return street;
  }

  fetchTrafficData().then((data) => {
    const el = document.getElementById('traffic-strip');
    if (!el || !data) {
      if (el) el.innerHTML = '';
      return;
    }

    const s = data.summary;
    const pctFluido = Math.round((s.fluido / s.totalSensors) * 100);
    const pctDenso = Math.round((s.denso / s.totalSensors) * 100);
    const pctCongest = Math.round((s.congestionado / s.totalSensors) * 100);
    const pctCortado = Math.round((s.cortado / s.totalSensors) * 100);
    const pctOk = pctFluido + pctDenso;

    const congestedCount = s.congestionado + s.cortado;
    let ledeColor = '#2D6A4F';
    let lede = '';
    if (pctCongest + pctCortado >= 20) {
      ledeColor = '#E76F51';
      lede = t('index.trafficLedeHigh').replace('{pct}', String(pctCongest + pctCortado));
    } else if (pctCongest + pctCortado >= 5) {
      ledeColor = '#E9C46A';
      lede = t('index.trafficLedeMedium').replace('{pct}', String(pctOk));
    } else if (congestedCount === 0) {
      lede = t('index.trafficLedePerfect');
    } else {
      lede = t('index.trafficLedeGood').replace('{pct}', String(pctOk));
    }

    // Hotspots: only congested/blocked, with links
    const hotspots = data.sensors
      .filter((sen) => sen.level >= 2)
      .sort((a, b) => b.load - a.load)
      .slice(0, 5);

    const levelLabel = (l: number) => [t('index.trafficFluido'), t('index.trafficDenso'), t('index.trafficCongestionado'), t('index.trafficCortado')][l] || '';
    const levelColor = (l: number) => ['#2D6A4F', '#E9C46A', '#E76F51', '#264653'][l] || '#6C757D';

    const cleanedHotspots = hotspots
      .map((h) => ({ ...h, cleanName: cleanStreet(h.description) }))
      .filter((h) => h.cleanName.length > 0);

    const hotspotsHtml = cleanedHotspots.length > 0 ? `
      <details class="traffic-hotspots" open>
        <summary>${cleanedHotspots.length} ${t('index.trafficHotspotsSummary')}</summary>
        <div class="traffic-hotspot-list">
          ${cleanedHotspots.map((h) => {
            const slug = districtSlugs[h.districtCode] || '';
            const href = slug ? `/barrio/${slug}` : '#';
            return `
            <a href="${href}" class="traffic-hotspot-row">
              <span class="traffic-hotspot-dot" style="background:${levelColor(h.level)}"></span>
              <span class="traffic-hotspot-name">${h.cleanName}</span>
            </a>`;
          }).join('')}
        </div>
      </details>
    ` : '';

    el.innerHTML = `
      <p class="traffic-strip-lede">${lede.replace('{color}', ledeColor)}</p>
      <div class="traffic-pulse-wrap">
        <div class="traffic-pulse">
          <div class="pulse-seg" style="width:${pctFluido}%;background:#2D6A4F"></div>
          <div class="pulse-seg" style="width:${pctDenso}%;background:#E9C46A"></div>
          <div class="pulse-seg" style="width:${Math.max(pctCongest, 1)}%;background:#E76F51"></div>
          <div class="pulse-seg" style="width:${Math.max(pctCortado, 1)}%;background:#264653"></div>
        </div>
        <div class="pulse-labels">
          <span><span class="pulse-dot" style="background:#2D6A4F"></span> ${t('index.trafficFluido')} ${pctFluido}%</span>
          <span><span class="pulse-dot" style="background:#E9C46A"></span> ${t('index.trafficDenso')} ${pctDenso}%</span>
          <span><span class="pulse-dot" style="background:#E76F51"></span> ${t('index.trafficCongestionado')} ${pctCongest}%</span>
          <span><span class="pulse-dot" style="background:#264653"></span> ${t('index.trafficCortado')} ${pctCortado}%</span>
        </div>
      </div>
      ${hotspotsHtml}
      <p class="traffic-strip-meta">${data.timestamp} · <a href="https://datos.madrid.es/dataset/202087-0-trafico-intensidad" target="_blank" rel="noopener">${t('index.trafficSourceLink')}</a></p>
    `;
  });
</script>

