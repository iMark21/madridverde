---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapaMadrid from '../components/MapaMadrid.astro';
import SeccionComparador from '../components/SeccionComparador.astro';
import SeccionTendencias from '../components/SeccionTendencias.astro';
import { computeGreenIndex } from '../lib/green-index';

const districts = computeGreenIndex();
const avgScore = Math.round(districts.reduce((s, d) => s + d.score, 0) / districts.length);
const best = [...districts].sort((a, b) => b.score - a.score)[0];
const worst = [...districts].sort((a, b) => a.score - b.score)[0];

function titleCase(str: string): string {
  const minor = new Set(['de', 'del', 'el', 'la', 'las', 'los', 'y', 'e']);
  return str.toLowerCase().split(' ')
    .map((w, i) => (i === 0 || !minor.has(w)) ? w.charAt(0).toUpperCase() + w.slice(1) : w)
    .join(' ');
}

function slugify(name: string): string {
  return name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
---

<BaseLayout title="MadridVerde — Índice Verde de Madrid" description="Dashboard medioambiental que transforma 14 datasets abiertos en un Índice Verde por distrito de Madrid">

  <!-- SECTION: MAPA -->
  <section id="mapa" class="section">
    <div class="section-header section-header--hero">
      <h1 data-i18n="index.title">Índice Verde de Madrid</h1>
      <p class="section-subtitle" data-i18n="index.subtitle">17 datasets abiertos, un solo score por distrito</p>
      <div class="search-box">
        <input type="text" id="address-search" placeholder="Busca tu dirección en Madrid..." aria-label="Buscar dirección" data-i18n-placeholder="index.searchPlaceholder" data-i18n-aria="index.searchAriaLabel" autocomplete="off" />
        <ul id="search-results" class="search-results" role="listbox" aria-label="Resultados de búsqueda"></ul>
      </div>
    </div>

    <div class="stats">
      <div class="stat-card">
        <span class="stat-value">{avgScore}</span>
        <span class="stat-label" data-i18n="index.statAvgLabel">Media de Madrid</span>
      </div>
      <div class="stat-card stat-card--best">
        <span class="stat-value">{best.score}</span>
        <span class="stat-label">{titleCase(best.name)}</span>
        <span class="stat-badge" data-i18n="index.statBestBadge">Mejor distrito</span>
      </div>
      <div class="stat-card stat-card--worst">
        <span class="stat-value">{worst.score}</span>
        <span class="stat-label">{titleCase(worst.name)}</span>
        <span class="stat-badge" data-i18n="index.statWorstBadge">Necesita atención</span>
      </div>
      <div class="stat-card">
        <span class="stat-value">14</span>
        <span class="stat-label" data-i18n="index.statDatasetsLabel">Datasets abiertos</span>
      </div>
    </div>

    <div class="map-wrapper">
      <MapaMadrid />
    </div>

    <div class="traffic-strip" id="traffic-strip">
      <p class="traffic-strip-loading" data-i18n="index.trafficLoading">Cargando tráfico...</p>
    </div>

    <div class="ranking">
      <h2 data-i18n="index.rankingTitle">Ranking de distritos</h2>
      <div class="ranking-list">
        {districts.sort((a, b) => b.score - a.score).map((d, i) => (
          <a href={`/barrio/${slugify(d.name)}`} class="ranking-item" data-code={d.code} data-analytics="district_viewed" data-analytics-district_name={titleCase(d.name)} data-analytics-source="ranking">
            <span class="ranking-pos">#{i + 1}</span>
            <span class="ranking-bar" style={`width: ${d.score}%; background: ${d.tierColor}`}></span>
            <span class="ranking-name">{titleCase(d.name)}</span>
            <span class="ranking-score" style={`color: ${d.tierColor}`}>{d.score}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION: BICIMAD -->
  <section id="bicimad" class="section">
    <div class="section-header">
      <h2 data-i18n="index.bicimadTitle">BiciMAD en tiempo real</h2>
      <p class="section-subtitle" data-i18n="index.bicimadSubtitle">635 estaciones de bicicleta pública — disponibilidad actualizada cada 14 segundos</p>
    </div>
    <div class="bicimad-dashboard" id="bicimad-dashboard">
      <div class="bicimad-stats" id="bicimad-stats">
        <p class="bicimad-loading" data-i18n="index.bicimadLoading">Cargando datos en vivo de BiciMAD...</p>
      </div>
      <div class="bicimad-list" id="bicimad-list"></div>
    </div>
  </section>

  <!-- SECTION: EMT -->
  <section id="emt" class="section">
    <div class="section-header">
      <h2 data-i18n="index.emtTitle">Autobuses EMT</h2>
      <p class="section-subtitle" data-i18n="index.emtSubtitle">4.910 paradas y 235 líneas — frecuencia media en hora punta y alertas en tiempo real</p>
    </div>
    <div class="emt-dashboard">
      <div class="emt-global-stats">
        <div class="emt-gstat"><strong>4.910</strong> <span data-i18n="index.emtParadas">paradas</span></div>
        <div class="emt-gstat"><strong>235</strong> <span data-i18n="index.emtLineas">líneas</span></div>
        <div class="emt-gstat"><strong>21</strong> <span data-i18n="index.emtDistritos">distritos cubiertos</span></div>
      </div>
      <div class="emt-alerts" id="emt-alerts">
        <p class="emt-alerts-loading" data-i18n="index.emtAlertsLoading">Cargando incidencias en tiempo real...</p>
      </div>
      <div class="emt-district-table">
        <table>
          <thead>
            <tr>
              <th data-i18n="index.emtThDistrito">Distrito</th>
              <th data-i18n="index.emtThParadas">Paradas</th>
              <th data-i18n="index.emtThLineas">Líneas</th>
              <th data-i18n="index.emtThFreq">Freq. media (min)</th>
            </tr>
          </thead>
          <tbody id="emt-table-body"></tbody>
        </table>
      </div>
      <p class="emt-source-note" data-i18n="index.emtSourceNote">Fuente: EMT Madrid — datos.emtmadrid.es (GTFS) + openapi.emtmadrid.es (alertas en tiempo real)</p>
    </div>
  </section>

  <!-- SECTION: COMPARAR -->
  <section id="comparar" class="section">
    <div class="section-header">
      <h2 data-i18n="index.compareTitle">Comparar distritos</h2>
      <p class="section-subtitle" data-i18n="index.compareSubtitle">Selecciona 2 a 4 distritos para comparar sus sub-índices</p>
    </div>
    <SeccionComparador />
  </section>

  <!-- SECTION: TENDENCIAS -->
  <section id="tendencias" class="section">
    <div class="section-header">
      <h2 data-i18n="index.trendsTitle">Tendencias históricas</h2>
      <p class="section-subtitle" data-i18n="index.trendsSubtitle">Cómo ha cambiado la calidad ambiental de Madrid. Selecciona estaciones para comparar</p>
    </div>
    <SeccionTendencias />
  </section>

  <!-- SECTION: METODOLOGIA + IA + DATOS -->
  <section id="metodologia" class="section">
    <div class="section-header">
      <h2 data-i18n="index.methodologyTitle">Metodología</h2>
      <p class="section-subtitle" data-i18n="index.methodologySubtitle">Transparencia total: cómo se calcula el Índice Verde</p>
    </div>

    <div class="formula-card">
      <p class="formula-title" data-i18n="index.formulaTitle">Índice Verde (0-100)</p>
      <p class="formula" data-i18n="index.formula">IV = Aire x 0.30 + Verde x 0.25 + Ruido x 0.20 + Movilidad x 0.15 + Reciclaje x 0.10</p>
    </div>

    <div class="subindex-grid">
      <div class="subindex-card">
        <h3><span data-i18n="index.subAire">Aire</span> <span class="sw">30%</span></h3>
        <p data-i18n="index.subAireDesc">NO2, PM2.5, PM10, O3 en tiempo real. 24 estaciones, 4 contaminantes. Límites OMS.</p>
      </div>
      <div class="subindex-card">
        <h3><span data-i18n="index.subVerde">Verde</span> <span class="sw">25%</span></h3>
        <p data-i18n="index.subVerdeDesc">793.000 árboles censados + m2 zonas verdes por habitante. OMS recomienda mínimo 9 m2/hab.</p>
      </div>
      <div class="subindex-card">
        <h3><span data-i18n="index.subRuido">Ruido</span> <span class="sw">20%</span></h3>
        <p data-i18n="index.subRuidoDesc">37 estaciones acústicas SIVCA. Series desde 1998. OMS recomienda máximo 55 dB.</p>
      </div>
      <div class="subindex-card">
        <h3><span data-i18n="index.subMovilidad">Movilidad</span> <span class="sw">15%</span></h3>
        <p data-i18n="index.subMovilidadDesc">~4.000 sensores de tráfico en tiempo real. Nivel de servicio: fluido, denso, congestionado.</p>
      </div>
      <div class="subindex-card">
        <h3><span data-i18n="index.subReciclaje">Reciclaje</span> <span class="sw">10%</span></h3>
        <p data-i18n="index.subReciclajeDesc">44.251 contenedores por tipo (papel, vidrio, orgánica, envases) per cápita.</p>
      </div>
    </div>

    <div class="datasets-list">
      <h3 data-i18n="index.datasetsTitle">17 conjuntos de datos del Portal de Datos Abiertos</h3>
      <div class="datasets-grid">
        <div class="dataset-group">
          <h4 data-i18n="index.dsRealtime">Tiempo real</h4>
          <ul>
            <li><a href="https://datos.madrid.es/dataset/201200-0-calidad-aire-horario" target="_blank" rel="noopener" data-i18n="index.dsAirHourly">Calidad del aire — datos horarios</a></li>
            <li><a href="https://datos.madrid.es/dataset/202087-0-trafico-intensidad" target="_blank" rel="noopener" data-i18n="index.dsTrafficRealtime">Tráfico — intensidad en tiempo real</a></li>
          </ul>
        </div>
        <div class="dataset-group">
          <h4 data-i18n="index.dsStations">Estaciones y sensores</h4>
          <ul>
            <li><a href="https://datos.madrid.es/dataset/212629-0-estaciones-control-aire" target="_blank" rel="noopener" data-i18n="index.dsAirStations">Estaciones de control de calidad del aire</a></li>
            <li><a href="https://datos.madrid.es/dataset/211346-0-estaciones-acusticas" target="_blank" rel="noopener" data-i18n="index.dsNoiseStations">Estaciones acústicas — contaminación</a></li>
            <li><a href="https://datos.madrid.es/dataset/202468-0-intensidad-trafico" target="_blank" rel="noopener" data-i18n="index.dsTrafficSensors">Puntos de medida de tráfico</a></li>
          </ul>
        </div>
        <div class="dataset-group">
          <h4 data-i18n="index.dsEnvironment">Medio ambiente</h4>
          <ul>
            <li><a href="https://datos.madrid.es/dataset/300761-0-arbolado-especies" target="_blank" rel="noopener" data-i18n="index.dsTreesParks">Arbolado en parques — detalle especies</a></li>
            <li><a href="https://datos.madrid.es/dataset/300266-0-arbolado-superficie" target="_blank" rel="noopener" data-i18n="index.dsTreesGreenAreas">Arbolado — superficie zonas verdes</a></li>
            <li><a href="https://datos.madrid.es/dataset/200761-0-parques-jardines" target="_blank" rel="noopener" data-i18n="index.dsParks">Parques y jardines municipales</a></li>
            <li><a href="https://datos.madrid.es/dataset/300276-0-contenedor-papel-carton-todos" target="_blank" rel="noopener" data-i18n="index.dsRecyclingContainers">Contenedores de recogida de residuos</a></li>
          </ul>
        </div>
        <div class="dataset-group">
          <h4 data-i18n="index.dsHistorical">Histórico y sociodemográfico</h4>
          <ul>
            <li><a href="https://datos.madrid.es/dataset/201410-0-calidad-aire-diario" target="_blank" rel="noopener" data-i18n="index.dsAirDaily">Calidad del aire — datos diarios desde 2001</a></li>
            <li><a href="https://datos.madrid.es/dataset/215885-0-contaminacion-ruido" target="_blank" rel="noopener" data-i18n="index.dsNoiseDaily">Contaminación acústica — datos diarios</a></li>
            <li><a href="https://datos.madrid.es/dataset/300087-0-indicadores-distritos" target="_blank" rel="noopener" data-i18n="index.dsDistrictIndicators">Indicadores de distritos y barrios</a></li>
          </ul>
        </div>
        <div class="dataset-group">
          <h4 data-i18n="index.dsMobility">Movilidad sostenible</h4>
          <ul>
            <li><a href="https://datos.madrid.es/dataset/900021-0-bicimad-gbfs" target="_blank" rel="noopener" data-i18n="index.dsBicimadLive">BiciMAD — disponibilidad en tiempo real (GBFS)</a></li>
            <li><a href="https://datos.madrid.es/dataset/300242-0-bicimad-estaciones" target="_blank" rel="noopener" data-i18n="index.dsBicimadStations">BiciMAD — estaciones</a></li>
            <li><a href="https://datos.madrid.es/dataset/205107-0-vias-ciclistas" target="_blank" rel="noopener" data-i18n="index.dsBikeLanes">Infraestructura ciclista — carriles bici</a></li>
          </ul>
        </div>
        <div class="dataset-group">
          <h4 data-i18n="index.dsGeographic">Límites geográficos</h4>
          <ul>
            <li><a href="https://geoportal.madrid.es/IDEAM_WBGEOPORTAL/dataset.iam?id=541f4ef6-762b-11e9-861d-ecb1d753f6e8" target="_blank" rel="noopener" data-i18n="index.dsDistrictBoundaries">Límites administrativos — distritos</a></li>
            <li><a href="https://geoportal.madrid.es/IDEAM_WBGEOPORTAL/dataset.iam?id=422fa235-762b-11e9-861d-ecb1d753f6e8" target="_blank" rel="noopener" data-i18n="index.dsNeighborhoodBoundaries">Límites administrativos — barrios</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="tiers">
      <div class="tier" style="--tier-color: #2D6A4F"><span class="tier-range">85-100</span> <span data-i18n="tier.excellent">Excelente</span></div>
      <div class="tier" style="--tier-color: #52B788"><span class="tier-range">70-84</span> <span data-i18n="tier.good">Bueno</span></div>
      <div class="tier" style="--tier-color: #E9C46A"><span class="tier-range">55-69</span> <span data-i18n="tier.acceptable">Aceptable</span></div>
      <div class="tier" style="--tier-color: #F4A261"><span class="tier-range">40-54</span> <span data-i18n="tier.improvable">Mejorable</span></div>
      <div class="tier" style="--tier-color: #E76F51"><span class="tier-range">0-39</span> <span data-i18n="tier.critical">Crítico</span></div>
    </div>
  </section>

  <!-- SECTION: IA + DATOS -->
  <section id="mcp" class="section">
    <div class="section-header">
      <h2 data-i18n="index.mcpTitle">Pregunta a tu IA sobre Madrid</h2>
      <p class="section-subtitle" data-i18n="index.mcpSubtitle">Integra los datos de MadridVerde en Claude, ChatGPT o Cursor</p>
    </div>
    <div class="mcp-card">
      <div class="mcp-content">
        <div class="mcp-demo">
          <div class="mcp-chat">
            <div class="mcp-msg mcp-msg--user">
              <p data-i18n="index.mcpQ1">¿Cómo está la calidad del aire en Chamberí ahora mismo?</p>
            </div>
            <div class="mcp-msg mcp-msg--ai">
              <p data-i18n="index.mcpA1">Chamberí tiene un nivel de NO2 de 28 ug/m3 (por debajo del límite UE de 40). La estación más cercana es Cuatro Caminos. Índice Verde del distrito: 67/100 (Aceptable).</p>
            </div>
            <div class="mcp-msg mcp-msg--user">
              <p data-i18n="index.mcpQ2">¿Hay incidencias en la línea 27?</p>
            </div>
            <div class="mcp-msg mcp-msg--ai">
              <p data-i18n="index.mcpA2">Sí, hay 2 alertas activas en la línea 27: una concentración en paseo del Prado y un evento en el Estadio Santiago Bernabéu que afectan al itinerario.</p>
            </div>
          </div>
        </div>
        <div class="mcp-info">
          <h3 data-i18n="index.mcpHowTitle">Cómo funciona</h3>
          <p data-i18n="index.mcpHowDesc">MadridVerde MCP es un servidor que permite a cualquier asistente de inteligencia artificial consultar datos medioambientales de Madrid en lenguaje natural. 10 herramientas, datos en tiempo real, sin API key.</p>
          <div class="mcp-tools-list">
            <span class="mcp-tool-tag">get_air_quality</span>
            <span class="mcp-tool-tag">get_noise_levels</span>
            <span class="mcp-tool-tag">get_green_index</span>
            <span class="mcp-tool-tag">get_green_areas</span>
            <span class="mcp-tool-tag">get_bicimad</span>
            <span class="mcp-tool-tag">get_traffic</span>
            <span class="mcp-tool-tag">get_emt_alerts</span>
            <span class="mcp-tool-tag">compare_districts</span>
            <span class="mcp-tool-tag">find_district</span>
            <span class="mcp-tool-tag">find_nearby</span>
          </div>
          <div class="mcp-actions">
            <a href="https://github.com/iMark21/madridverde-mcp" target="_blank" rel="noopener" class="mcp-cta" data-i18n="index.mcpCta">Ver en GitHub</a>
            <button class="mcp-cta mcp-cta--csv" id="export-csv-btn">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v9M4 8l4 4 4-4"/><path d="M2 13h12"/></svg>
              <span data-i18n="export.button">Descargar datos (CSV)</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<!-- Page view analytics -->
<script>
  if (window.__mvAnalytics) {
    window.__mvAnalytics('page_viewed', { page_type: 'home' });
  }
</script>

<!-- Sync ranking with real-time scores emitted by MapaMadrid -->
<script>
  window.addEventListener('mv-index-updated', (e: any) => {
    const updated: any[] = e.detail;
    const rankingList = document.querySelector('.ranking-list');
    if (!rankingList) return;

    const items = Array.from(rankingList.querySelectorAll('.ranking-item[data-code]')) as HTMLElement[];
    items.forEach((el) => {
      const d = updated.find((x: any) => x.code === el.dataset.code);
      if (!d) return;
      const scoreEl = el.querySelector('.ranking-score') as HTMLElement;
      const barEl = el.querySelector('.ranking-bar') as HTMLElement;
      if (scoreEl) { scoreEl.textContent = String(d.score); scoreEl.style.color = d.tierColor; }
      if (barEl) { barEl.style.width = `${d.score}%`; barEl.style.background = d.tierColor; }
    });

    // Re-sort by updated score
    const sorted = [...items].sort((a, b) => {
      const aS = parseInt((a.querySelector('.ranking-score') as HTMLElement)?.textContent || '0');
      const bS = parseInt((b.querySelector('.ranking-score') as HTMLElement)?.textContent || '0');
      return bS - aS;
    });
    sorted.forEach((item, i) => {
      const posEl = item.querySelector('.ranking-pos') as HTMLElement;
      if (posEl) posEl.textContent = `#${i + 1}`;
      rankingList.appendChild(item);
    });
  });
</script>

<!-- BiciMAD dashboard script -->
<script>
  import { fetchBiciMAD } from '../lib/bicimad';
  import { t } from '../i18n/i18n.js';

  fetchBiciMAD().then((stations) => {
    const statsEl = document.getElementById('bicimad-stats');
    const listEl = document.getElementById('bicimad-list');
    if (!statsEl || !listEl || stations.length === 0) {
      if (statsEl) statsEl.innerHTML = `<p>${t('index.bicimadError')}</p>`;
      return;
    }

    const active = stations.filter(s => s.inService);
    const totalBikes = active.reduce((s, st) => s + st.bikesAvailable, 0);
    const totalDocks = active.reduce((s, st) => s + st.docksAvailable, 0);
    const totalCapacity = active.reduce((s, st) => s + st.capacity, 0);
    const availability = totalCapacity > 0 ? Math.round((totalBikes / totalCapacity) * 100) : 0;

    statsEl.innerHTML = `
      <div class="bici-stat"><span class="bici-stat-value">${active.length}</span><span class="bici-stat-label" data-i18n="index.bicimadActiveStations">${t('index.bicimadActiveStations')}</span></div>
      <div class="bici-stat"><span class="bici-stat-value">${totalBikes.toLocaleString('es-ES')}</span><span class="bici-stat-label" data-i18n="index.bicimadBikesAvailable">${t('index.bicimadBikesAvailable')}</span></div>
      <div class="bici-stat"><span class="bici-stat-value">${totalDocks.toLocaleString('es-ES')}</span><span class="bici-stat-label" data-i18n="index.bicimadDocksAvailable">${t('index.bicimadDocksAvailable')}</span></div>
      <div class="bici-stat"><span class="bici-stat-value">${availability}%</span><span class="bici-stat-label" data-i18n="index.bicimadAvailability">${t('index.bicimadAvailability')}</span></div>
    `;

    // Top 10 stations with most bikes
    const top = [...active].sort((a, b) => b.bikesAvailable - a.bikesAvailable).slice(0, 10);
    listEl.innerHTML = `<h3 data-i18n="index.bicimadTopStations">${t('index.bicimadTopStations')}</h3>` +
      top.map(s => {
        const pct = s.capacity > 0 ? Math.round((s.bikesAvailable / s.capacity) * 100) : 0;
        return `<div class="bici-row">
          <span class="bici-name">${s.name}</span>
          <div class="bici-bar-track"><div class="bici-bar-fill" style="width:${pct}%"></div></div>
          <span class="bici-count">${s.bikesAvailable}/${s.capacity}</span>
        </div>`;
      }).join('');
  });
</script>

<!-- Search geocoding script -->
<script>
  import { t as tSearch, getLang as getSearchLang } from '../i18n/i18n.js';

  const input = document.getElementById('address-search') as HTMLInputElement;
  const results = document.getElementById('search-results') as HTMLUListElement;
  let debounceTimer: number;

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const q = input.value.trim();
    if (q.length < 3) { results.classList.remove('visible'); return; }
    debounceTimer = window.setTimeout(async () => {
      try {
        const acceptLang = getSearchLang() === 'en' ? 'en' : 'es';
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q + ', Madrid, Spain')}&limit=5&addressdetails=1&viewbox=-3.89,40.31,-3.52,40.56&bounded=1`;
        const res = await fetch(url, { headers: { 'Accept-Language': acceptLang } });
        const data = await res.json();
        results.innerHTML = '';
        if (window.__mvAnalytics) {
          window.__mvAnalytics('map_search_used', { query: q, has_result: String(data.length > 0) });
        }
        if (data.length === 0) {
          results.innerHTML = `<li>${tSearch('index.searchNoResults')}</li>`;
        } else {
          data.forEach((item: any) => {
            const li = document.createElement('li');
            li.role = 'option';
            li.textContent = item.display_name.replace(', España', '').replace(', Comunidad de Madrid', '');
            li.addEventListener('click', () => {
              window.dispatchEvent(new CustomEvent('mv-geocode', { detail: { lat: parseFloat(item.lat), lon: parseFloat(item.lon) } }));
              results.classList.remove('visible');
              input.value = li.textContent || '';
            });
            results.appendChild(li);
          });
        }
        results.classList.add('visible');
      } catch {}
    }, 500);
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.search-box')) results.classList.remove('visible');
  });
</script>

