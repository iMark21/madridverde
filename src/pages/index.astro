---
import BaseLayout from '../layouts/BaseLayout.astro';
import MapaMadrid from '../components/MapaMadrid.astro';
import { computeGreenIndex } from '../lib/green-index';

const districts = computeGreenIndex();
const avgScore = Math.round(districts.reduce((s, d) => s + d.score, 0) / districts.length);
const best = [...districts].sort((a, b) => b.score - a.score)[0];
const worst = [...districts].sort((a, b) => a.score - b.score)[0];

function titleCase(str: string): string {
  const minor = new Set(['de', 'del', 'el', 'la', 'las', 'los', 'y', 'e']);
  return str.toLowerCase().split(' ')
    .map((w, i) => (i === 0 || !minor.has(w)) ? w.charAt(0).toUpperCase() + w.slice(1) : w)
    .join(' ');
}
---

<BaseLayout title="MadridVerde — Indice Verde de Madrid" description="Dashboard medioambiental que transforma 14 datasets abiertos en un Indice Verde por distrito de Madrid">
  <section class="hero">
    <div class="hero-text">
      <h1>Indice Verde de Madrid</h1>
      <p class="hero-subtitle">14 datasets abiertos, un solo score por distrito</p>
      <p class="hero-cta">Haz clic en un distrito para ver su scorecard</p>
    </div>
    <div class="hero-map">
      <MapaMadrid />
    </div>
  </section>

  <section class="stats">
    <div class="stat-card">
      <span class="stat-value">{avgScore}</span>
      <span class="stat-label">Media de Madrid</span>
    </div>
    <div class="stat-card stat-card--best">
      <span class="stat-value">{best.score}</span>
      <span class="stat-label">{titleCase(best.name)}</span>
      <span class="stat-badge">Mejor distrito</span>
    </div>
    <div class="stat-card stat-card--worst">
      <span class="stat-value">{worst.score}</span>
      <span class="stat-label">{titleCase(worst.name)}</span>
      <span class="stat-badge">Necesita atencion</span>
    </div>
    <div class="stat-card">
      <span class="stat-value">14</span>
      <span class="stat-label">Datasets abiertos</span>
    </div>
  </section>

  <section class="ranking">
    <h2>Ranking de distritos</h2>
    <div class="ranking-list">
      {districts.sort((a, b) => b.score - a.score).map((d, i) => (
        <a href={`/barrio/${d.code === '01' ? 'centro' : districts.find(x => x.code === d.code) ? d.name.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : d.code}`} class="ranking-item">
          <span class="ranking-pos">#{i + 1}</span>
          <span class="ranking-bar" style={`width: ${d.score}%; background: ${d.tierColor}`}></span>
          <span class="ranking-name">{titleCase(d.name)}</span>
          <span class="ranking-score" style={`color: ${d.tierColor}`}>{d.score}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
  }

  .hero-text {
    padding: 2rem 2rem 1rem;
    text-align: center;
  }

  .hero-text h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-bosque);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    margin-top: 0.5rem;
  }

  .hero-cta {
    font-size: 0.85rem;
    color: var(--color-hoja);
    margin-top: 0.25rem;
    font-style: italic;
  }

  .hero-map {
    flex: 1;
    margin: 0 2rem 2rem;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    padding: 0 2rem;
    margin-top: -1rem;
  }

  .stat-card {
    background: white;
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--color-tinta);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-piedra);
  }

  .stat-badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .stat-card--best .stat-value { color: var(--color-bosque); }
  .stat-card--best .stat-badge { color: var(--color-bosque); }
  .stat-card--worst .stat-value { color: var(--color-arcilla); }
  .stat-card--worst .stat-badge { color: var(--color-arcilla); }

  /* Ranking */
  .ranking {
    padding: 3rem 2rem 0;
    max-width: 960px;
    margin: 0 auto;
  }

  .ranking h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .ranking-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ranking-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    background: white;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: transform 0.1s;
  }

  .ranking-item:hover {
    transform: translateX(4px);
  }

  .ranking-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    opacity: 0.1;
    border-radius: 8px;
  }

  .ranking-pos {
    font-size: 0.8rem;
    color: var(--color-piedra);
    font-weight: 600;
    z-index: 1;
  }

  .ranking-name {
    font-weight: 500;
    color: var(--color-tinta);
    z-index: 1;
  }

  .ranking-score {
    font-family: var(--font-display);
    font-size: 1.5rem;
    z-index: 1;
  }

  @media (max-width: 768px) {
    .hero-map {
      margin: 0;
    }
    .hero-text {
      padding: 1.5rem 1rem 0.75rem;
    }
    .stats {
      grid-template-columns: repeat(2, 1fr);
      padding: 0 1rem;
    }
    .ranking {
      padding: 2rem 1rem 0;
    }
  }
</style>
